{
  "name": "t-tax-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @t-tax/desktop dev",
    "dev:web": "pnpm --filter @t-tax/web dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @t-tax/core build && pnpm --filter @t-tax/db build && pnpm --filter @t-tax/mcp build && pnpm --filter @t-tax/ui build && pnpm --filter @t-tax/desktop build",
    "dist:mac": "pnpm build:desktop && pnpm --filter @t-tax/desktop dist:mac",
    "dist:win": "pnpm build:desktop && pnpm --filter @t-tax/desktop dist:win",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages apps test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:mac": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@t-tax/core": "workspace:*",
    "@t-tax/db": "workspace:*",
    "@t-tax/mcp": "workspace:*",
    "@types/node": "^24.9.0",
    "@types/node-forge": "^1.3.14",
    "eslint": "^9.39.5",
    "exceljs": "^4.4.0",
    "node-forge": "^1.4.4",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.0",
    "xml-crypto": "^6.4.0"
  }
}
