{
  "name": "@t-tax/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T-Tax Model Context Protocol (MCP v2) Server & External MCP Client Hub for Vietnam AI Accounting",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "t-tax-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@t-tax/core": "workspace:*",
    "@t-tax/db": "workspace:*",
    "zod": "^4.3.0"
  }
}
