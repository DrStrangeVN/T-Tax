{
  "name": "@t-tax/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./src/browser.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.125",
    "@ai-sdk/mistral": "^4.0.89",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@fast-csv/format": "^5.0.7",
    "@fast-csv/parse": "^5.0.7",
    "@napi-rs/canvas": "^1.2.0",
    "ai": "^7.0.181",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "imapflow": "^2.12.2",
    "jszip": "^3.10.2",
    "mailparser": "^3.15.0",
    "node-forge": "^1.4.4",
    "pdfjs-dist": "^5.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "xml-crypto": "^6.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5"
  }
}
